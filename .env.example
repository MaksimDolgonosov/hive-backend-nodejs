# База данных (Docker, порт 27018 — см. README про конфликт с локальным MongoDB)
MONGO_URI="mongodb://sting:sting_dev_password@localhost:27018/sting_app?authSource=admin"

# JWT — замените на случайные строки для локальной разработки
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"

# Порт API
PORT=3000

# Публичный URL API (для imageUrl жала при STORAGE_DRIVER=local)
BASE_URL=http://localhost:3000

# Время жизни жала в часах
STING_TTL_HOURS=4

# Хранилище фото: local (по умолчанию) или r2
STORAGE_DRIVER=local

# Cloudflare R2 (нужно при STORAGE_DRIVER=r2)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# Кластеризация ульев
HIVE_RADIUS_M=150
HIVE_ACTIVATION_THRESHOLD=3
# Интервал пересчёта ульев при TTL без replica set (мс)
HIVE_CLEANUP_INTERVAL_MS=60000

# Thumbnail (sharp)
THUMBNAIL_WIDTH=400
THUMBNAIL_QUALITY=80

# Анти-спуфинг публикации жал
STING_CAPTURED_AT_TOLERANCE_MS=120000
STING_EXIF_GPS_TOLERANCE_M=100
STING_MAX_GPS_ACCURACY_M=150
STING_MIN_GPS_ACCURACY_M=1

# Rate limit на POST /stings (на пользователя)
STING_RATE_LIMIT_MAX=10
STING_RATE_LIMIT_WINDOW_MS=3600000

# Аватар пользователя
AVATAR_SIZE=256
AVATAR_QUALITY=85

# NSFW-модерация публикаций (NSFWJS, локально в Node)
MODERATION_ENABLED=true
MODERATION_PORN_THRESHOLD=0.85
MODERATION_HENTAI_THRESHOLD=0.85
MODERATION_SEXY_THRESHOLD=0.92

# Google Sign-In (Web Client ID обязателен; можно указать все через запятую)
GOOGLE_CLIENT_IDS=

# Email OTP (регистрация и сброс пароля)
OTP_TTL_SEC=600
OTP_RESEND_COOLDOWN_SEC=60
OTP_MAX_ATTEMPTS=5
OTP_MAX_RESEND_PER_HOUR=5
OTP_PEPPER="change-me-otp-pepper"
OTP_DEV_LOG=true
OTP_DEFAULT_LOCALE=ru

# SMTP (в dev можно не заполнять — код пишется в консоль при OTP_DEV_LOG=true)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Hive <noreply@localhost>"
